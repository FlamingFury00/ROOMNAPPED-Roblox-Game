--!strict
--[[
	SkinDefs: cosmetic themes for rooms and suitcases. Skins never change room mechanics.

	source:
	  default - owned by everyone
	  shop    - bought with credits earned in expeditions (never with Robux)
	  mission - earned by choosing it as the reward target of a mission and extracting
	  mastery - granted once the player holds `stars` mission stars in total (Logic/Mastery)
]]

local Tables = require(script.Parent.Parent.Util.Tables)

export type Palette = {
	wall: Color3,
	wallMaterial: Enum.Material,
	floor: Color3,
	floorMaterial: Enum.Material,
	trim: Color3,
	trimMaterial: Enum.Material,
	accent: Color3,
	accentMaterial: Enum.Material,
	prop: Color3,
	light: Color3,
	lightBrightness: number,
	style: string,
	-- Patterned shell surfaces: MaterialVariant names from World/Palette (their own base materials) and the
	-- colour that tints them (white shows them as painted).
	wallSurface: string?,
	wallTint: Color3?,
	floorSurface: string?,
	floorTint: Color3?,
}

export type SkinDef = {
	id: string,
	kind: "room" | "suitcase",
	room: string?,
	nameKey: string,
	source: "default" | "shop" | "mission" | "mastery",
	price: number?,
	missionId: string?,
	stars: number?,
	order: number,
	palette: Palette,
}

local M = Enum.Material

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

