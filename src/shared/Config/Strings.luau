local Strings = {}

-- Look up a key and substitute {params}. Unknown keys fall back to the key itself (visible in QA).
function Strings.t(key: string, params: { [string]: any }?): string
	local text = catalog[key] or key
	if params then
		text = string.gsub(text, "{(%w+)}", function(name: string): string
			local value = params[name]
			if value == nil then
				return "{" .. name .. "}"
			end
			return tostring(value)
		end)
	end
	return text
end

function Strings.has(key: string): boolean
	return catalog[key] ~= nil
end

function Strings.keys(): { string }
	local out = {}
	for key in catalog do
		table.insert(out, key)
	end
	table.sort(out)
	return out
end

return Strings
